FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.8.0 torchvision==0.23.0 --index-url https://download.pytorch.org/whl/cu126
COPY backend/requirements.txt backend/requirements.txt
RUN git clone --depth 1 https://github.com/facebookresearch/sam3.git /opt/sam3 && pip install --no-cache-dir -e /opt/sam3 && pip install --no-cache-dir -r backend/requirements.txt transformers accelerate huggingface_hub einops 'setuptools<81'
COPY backend backend
COPY docs docs
ENV SAM3_REPO=/opt/sam3 GEODEVELOP_DATA=/data
CMD ["sh","-c","uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-8080}"]
