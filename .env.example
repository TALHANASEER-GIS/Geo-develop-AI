# Set privately on the backend. Never put credentials in docs/ or Git commits.
GEODEVELOP_API_KEY=replace-with-a-random-private-key-at-least-32-characters
GEODEVELOP_DATA=runtime-data
GEODEVELOP_ORIGINS=https://talhanaseer-gis.github.io,http://127.0.0.1:8765
GEODEVELOP_MAX_UPLOAD_BYTES=5368709120
# Earth Engine: configure application-default/user credentials in your runtime first.
EE_PROJECT=geo-develop-ai
# Use a local/open-source language model endpoint, e.g. Ollama.
GEODEVELOP_LLM_URL=http://127.0.0.1:11434/v1
GEODEVELOP_LLM_MODEL=qwen2.5:7b
# Alternatively, with transformers/accelerate installed:
# GEODEVELOP_LLM_PROVIDER=transformers
# GEODEVELOP_TRANSFORMERS_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# HF_TOKEN is required for approved SAM3 download, or provide SAM3_CHECKPOINT.
# HF_TOKEN=store-in-secret-manager-or-Colab-Secrets
# SAM3_CHECKPOINT=/private/path/sam3.pt
# SAM3_REPO=/opt/sam3
